# ShuyuanCore Environment Configuration
# Copy this file to .env and fill in your API keys

# LLM 模型
# WARNING: Replace with your actual API key. Leaving placeholder values will cause authentication failures.
# 警告：请替换为真实的 API Key，保留占位符将导致认证失败。
DASHSCOPE_API_KEY=your_dashscope_api_key
# WARNING: Replace with your actual API key. Leaving placeholder values will cause authentication failures.
# 警告：请替换为真实的 API Key，保留占位符将导致认证失败。
DEEPSEEK_API_KEY=your_deepseek_api_key
# WARNING: Replace with your actual API key. Leaving placeholder values will cause authentication failures.
# 警告：请替换为真实的 API Key，保留占位符将导致认证失败。
OPENAI_API_KEY=your_openai_api_key

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/state.db

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# 可选：锚点版本存储
ANCHOR_VERSION_PATH=./anchor_versions
