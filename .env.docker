# ShuyuanCore Docker Compose Environment Variables
# Copy this file to .env and fill in your values

# Required: API Keys
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: Host port (default: 8005)
HOST_PORT=8005

# Optional: Enable proactive prompting (default: false)
ENABLE_PROACTIVE=false

# Optional: Custom configuration path
# SHUYUANCORE_CONFIG=/app/config/custom.yaml
